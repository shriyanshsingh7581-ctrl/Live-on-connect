# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for canonical URLs, sitemap.xml, robots.txt, and API endpoints.
APP_URL="https://example.com"

# VITE_LIVE_STREAM_URL: Optional public HLS (.m3u8) or MP4 stream URL for the Live Stream page.
# Leave empty when no live event is actively broadcasting. Never put private RTMP keys here.
VITE_LIVE_STREAM_URL=""

# VITE_GOOGLE_PLAY_URL: Optional published Google Play Store app URL.
# When empty, the mobile app promotion section remains hidden.
VITE_GOOGLE_PLAY_URL=""

# VITE_WHATSAPP_NUMBER: Optional verified business WhatsApp number in international format (e.g. 919876543210).
# Leave empty until a real number is configured.
VITE_WHATSAPP_NUMBER=""

# WEBHOOK_URL: Optional server-side webhook URL for forwarding contact, quote, and newsletter submissions.
WEBHOOK_URL=""
